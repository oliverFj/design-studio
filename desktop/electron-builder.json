{
  "appId": "dk.design-studio.desktop",
  "productName": "Design Studio",
  "copyright": "Design Studio",
  "directories": {
    "output": "release/current",
    "buildResources": "desktop"
  },
  "asar": true,
  "npmRebuild": false,
  "files": [
    "desktop/main.mjs",
    "desktop/runtime.mjs",
    "desktop/icon.png",
    "server.mjs",
    "core/**/*",
    "studio/**/*",
    "packages/*.json",
    "assets/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "desktop/icon.ico",
    "signAndEditExecutable": true,
    "artifactName": "Design-Studio-${version}-portable.${ext}"
  },
  "portable": {
    "requestExecutionLevel": "user"
  },
  "publish": null
}
