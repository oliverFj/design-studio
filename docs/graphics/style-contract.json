  "rules": [
    {
      "id": "G-01",
      "key": "reference-first",
      "kind": "authoring-requirement",
      "requirement": "Vælg mindst tre registrerede motiver fra samme familie og angiv det konkrete træk, der videreføres.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    },
    {
      "id": "G-02",
      "key": "coordinate-system",
      "kind": "authoring-requirement",
      "requirement": "Brug 600 × 420, proportional skalering og billedfelt i ground; ingen automatisk beskæring eller non-scaling-stroke som kompensation.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    },
    {
      "id": "G-03",
      "key": "stroke-hierarchy",
      "kind": "authoring-requirement",
      "requirement": "Adskil kontur, tekstspor, guides, markører og materiale; ingen global stregmultiplikator.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    },
    {
      "id": "G-04",
      "key": "family-materials",
      "kind": "authoring-requirement",
      "requirement": "Brug semantiske grafikbindings efter familiens opskrift; brug ikke alle roller automatisk.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    },
    {
      "id": "G-05",
      "key": "text-hierarchy",
      "kind": "authoring-requirement",
      "requirement": "Fine varierede tekstspor og familiens glyph-skrift; ingen generel erstatning med massive tekstkapsler.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    },
    {
      "id": "G-06",
      "key": "semantic-geometry",
      "kind": "authoring-requirement",
      "requirement": "Form, hjørner, lys, landskab og perspektiv bestemmes af familie og betydning; ingen fælles motivskabelon på tværs af familier.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    },
    {
      "id": "G-07",
      "key": "exact-connections",
      "kind": "authoring-requirement",
      "requirement": "Del koordinater mellem relaterede former; kontrollér synlige kanter, åbninger og lagorden.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    },
    {
      "id": "G-08",
      "key": "scale-preservation",
      "kind": "authoring-requirement",
      "requirement": "Brug samme motiv stort og i produktstørrelse; en mikrovariant er et særskilt vurderet arbejde.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    },
    {
      "id": "G-09",
      "key": "static-final-state",
      "kind": "authoring-requirement",
      "requirement": "Slutgeometrien forklarer motivet uden afspilning; navngiv parts efter betydning.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    },
    {
      "id": "G-10",
      "key": "family-motion",
      "kind": "authoring-requirement",
      "requirement": "Følg familiens koreografi og fælles player; ingen egen tidsmotor eller automatisk loop.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    },
    {
      "id": "G-11",
      "key": "matched-comparison",
      "kind": "authoring-requirement",
      "requirement": "Sammenlign kandidat og referencer ved samme størrelse, tema, farvetilstand og færdige pose.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    },
    {
      "id": "G-12",
      "key": "explicit-deviations",
      "kind": "authoring-requirement",
      "requirement": "Registrér regel-id, ændring, begrundelse og reference ved afvigelser; teknisk gyldighed er ikke stilgodkendelse.",
      "source": "docs/GRAPHICS-AUTHORING.md#fælles-regler-for-gentaget-arbejde"
    }
  ],
